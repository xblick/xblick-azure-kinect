# xblick_k4a: the libraries of xblick-azure-kinect (CMakeLists.txt). Target xblick_k4a::xblick_k4a (the node, its
# sources and the depth engine's EGL context). Variable xblick_k4a_CUDA: built with XBLICK_K4A_CUDA.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(xblick_k4a_CUDA @XBLICK_K4A_CUDA@)
find_dependency(xblick 0.5.5)
find_dependency(k4a 1.4)
find_dependency(k4arecord 1.4)
find_dependency(nlohmann_json 3)
find_dependency(JPEG)
if(xblick_k4a_CUDA)
  find_dependency(CUDAToolkit 12)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/xblick_k4aTargets.cmake")
check_required_components(xblick_k4a)
